{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "jsx": "react-jsx", "resolveJsonModule": true,
    "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"], "noEmit": true
  },
  "include": ["src", "web", "tests", "scripts", "vite.config.ts", "playwright*.config.ts"]
}
